# Environment Configuration Template for Option 3 (Web EC2 + Dedicated PostgreSQL 16 on EC2)

# NextAuth session encryption secret (32-character random string)
# Retrieved dynamically from AWS Secrets Manager: ${EnvironmentName}-web-auth-secret
AUTH_SECRET=your_32_character_nextauth_secret_key_here

# Canonical base URL for NextAuth authentication redirects
AUTH_URL=http://localhost:3000

# PostgreSQL connection string with required SSL/TLS mode
# Dynamic value in EC2 LaunchTemplate: postgres://$DB_USER:$DB_PASS@<db-private-ip>:5432/appdb?sslmode=require
POSTGRES_URL=postgres://appuser:your_secure_password@10.0.10.15:5432/appdb?sslmode=require

# Compatibility alias for database connection string
DATABASE_URL=postgres://appuser:your_secure_password@10.0.10.15:5432/appdb?sslmode=require

# Application environment tier (dev | prod)
APP_ENV=dev

# Application HTTP server listening port (defaults to 80 in container, 3000 in local development)
PORT=3000

# Optional initial admin user bootstrap password (used only during initial table creation)
# INITIAL_USER_PASSWORD=your_initial_admin_password
